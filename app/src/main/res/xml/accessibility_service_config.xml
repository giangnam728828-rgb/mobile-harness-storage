<?xml version="1.0" encoding="utf-8"?>
<!--
    Read-only screen mirror. canPerformGestures is intentionally absent: this build
    only observes, it never taps or swipes on the user's behalf.
-->
<accessibility-service xmlns:android="http://schemas.android.com/apk/res/android"
    android:accessibilityEventTypes="typeWindowStateChanged|typeWindowContentChanged|typeViewScrolled|typeViewFocused"
    android:accessibilityFeedbackType="feedbackGeneric"
    android:accessibilityFlags="flagReportViewIds"
    android:canRetrieveWindowContent="true"
    android:description="@string/screen_reader_description"
    android:notificationTimeout="200"
    android:settingsActivity="com.jarves.mh.MainActivity" />
